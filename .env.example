# ---------------------------------------------------------------------------
# KasirPro Admin Portal — environment variables.
# Salin:  cp .env.example .env.local   (lalu isi nilainya)
# .env.local sudah masuk .gitignore — JANGAN pernah commit kuncinya.
# ---------------------------------------------------------------------------

# --- Supabase (wajib) -------------------------------------------------------
# WAJIB project Supabase yang SAMA dengan portal toko, supaya admin mengubah
# kuota yang benar-benar dipakai portal.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx

# Alias yang juga dibaca (pilih salah satu gaya, jangan isi dua-duanya):
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# --- Supabase (server only, JANGAN pakai prefix NEXT_PUBLIC_) --------------
# ⚠️ WAJIB service role key (bukan anon/publishable). Admin portal butuh
#    membaca & mengubah seluruh toko & key, yang tidak diizinkan RLS.
# Cara cek: Supabase Dashboard > Project Settings > API Keys > "service_role".
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxx
# Alias yang juga dibaca:
# SERVICE_KEY=sb_secret_xxxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Akses admin -----------------------------------------------------------
# Email super admin. Boleh lebih dari satu, pisah dengan koma:
#   ADMIN_EMAIL=admin@email.com
#   ADMIN_EMAIL=admin@email.com,owner@email.com
# Ini lapisan pertama; lapisan kedua adalah app_metadata.role='super_admin'
# yang dipasang lewat `npm run bootstrap:admin -- email@domain.com`.
ADMIN_EMAIL=admin@example.com

# --- Aplikasi --------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=KasirPro Admin

# --- Mode demo (opsional) --------------------------------------------------
# Isi 1 untuk mencoba aplikasi TANPA Supabase sama sekali: data dibuat
# palsu di memory, dan halaman /login menampilkan kredensial demo.
#
#   DEMO_MODE=1
#
# ⚠️ DEMO_MODE=1 dan env Supabase TIDAK BOLEH aktif bersamaan. Kombinasi itu
#    membuat `next build` GAGAL dengan pesan jelas — itu satu-satunya kombinasi
#    berbahaya, karena aplikasi dengan kredensial demo aktif masih bisa
#    menyentuh database asli. Jadi:
#      - lokal (tanpa Supabase)  -> DEMO_MODE=1 boleh
#      - Vercel / production     -> DEMO_MODE JANGAN diisi, isi env Supabase
#    Untuk deploy demo ke project Vercel terpisah, project itu tidak diberi
#    env Supabase sama sekali.
